# Copy to .env and fill in. .env is gitignored and must never be committed.

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://maqati3:@127.0.0.1:5432/maqati3

# ASR
SONIOX_API_KEY=

# Translation drafts, metadata, synthesis
ANTHROPIC_API_KEY=

# Reranking (phase 2)
VOYAGE_API_KEY=

# Admin sign-in — all four or none (empty = dashboard closed, partial = server refuses to start)
# Google OAuth client ID (Web application, see docs/BETRIEB.md)
GOOGLE_CLIENT_ID=
# Google OAuth client secret (see docs/BETRIEB.md)
GOOGLE_CLIENT_SECRET=
# The site's address, https://<domain>, without path
PUBLIC_URL=
# Signs the login cookie, min. 32 chars: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Google Drive / Docs / Sheets — OAuth refresh token of a human account,
# not a service account (service accounts have no Drive storage of their own)
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
REGISTER_SHEET_ID=
