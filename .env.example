# Copy to .env and fill in. .env is gitignored and must never be committed.

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://maqati3:@127.0.0.1:5432/maqati3

# ASR
SONIOX_API_KEY=

# Translation drafts, metadata, synthesis
ANTHROPIC_API_KEY=

# Reranking (phase 2)
VOYAGE_API_KEY=

# Google Drive / Docs / Sheets — OAuth refresh token of a human account,
# not a service account (service accounts have no Drive storage of their own)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
REGISTER_SHEET_ID=
